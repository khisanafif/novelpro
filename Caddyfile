:3000 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        root * /home/khisan/Desktop/novelpro/frontend
        try_files {path} /index.html
        file_server
    }
}
